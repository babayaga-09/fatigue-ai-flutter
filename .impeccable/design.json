  "components": [
    {
      "name": "Hero Fixture Scarf",
      "kind": "custom",
      "refersTo": "fixture-scarf-hero",
      "description": "72dp half-and-half matchday scarf; band widths equal win/draw/win probabilities, favourite's % on a solid panel at 3 stitches.",
      "html": "<div class=\"ds-fx\"><span class=\"ds-crest\">FCB</span><div class=\"ds-scarf\" role=\"img\" aria-label=\"Bayern win 72%, draw 18%, RB Leipzig win 10%\"><div class=\"ds-band ds-home\" style=\"flex:72\"><b class=\"ds-panel ds-lg\">72%</b></div><div class=\"ds-band ds-draw\" style=\"flex:18\"><b class=\"ds-panel ds-sm\">18%</b></div><div class=\"ds-band ds-away\" style=\"flex:10\"></div></div><span class=\"ds-crest ds-crest-b\">RBL</span></div>",
      "css": ".ds-fx{display:flex;align-items:center;gap:8px;background:#F6F6F2;padding:16px;border-radius:16px}.ds-crest{width:36px;height:36px;border-radius:9px;background:#DC052D;color:#fff;display:grid;place-items:center;font-family:'Jersey 10',monospace;font-variant-numeric:tabular-nums;line-height:1;font-size:12px}.ds-crest-b{background:#DD0741}.ds-scarf{flex:1;height:72px;display:flex;gap:1px;background:#EDEDE8;border:1px solid #C9CBC6;border-radius:3px;overflow:hidden;animation:ds-knit .65s cubic-bezier(.16,1,.3,1)}.ds-band{display:grid;place-items:center}.ds-home{background:repeating-linear-gradient(90deg,#DC052D 0 14px,#FFFFFF 14px 28px)}.ds-away{background:repeating-linear-gradient(90deg,#DD0741 0 14px,#FFFFFF 14px 28px)}.ds-draw{background:#7D838C}.ds-panel{font-family:'Jersey 10',monospace;font-variant-numeric:tabular-nums;line-height:1;font-weight:400;padding:0 6px;height:100%;display:grid;place-items:center;color:#fff}.ds-home .ds-panel{background:#DC052D}.ds-draw .ds-panel{background:#7D838C}.ds-lg{font-size:56px}.ds-sm{font-size:18.667px}@keyframes ds-knit{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0)}}@media (prefers-reduced-motion:reduce){.ds-scarf{animation:none}}"
    },
    {
      "name": "Form Scarf",
      "kind": "custom",
      "refersTo": "form-scarf",
      "description": "Last results as square cells: win solid, draw cross-stitch, loss dropped stitch, each lettered.",
      "html": "<div class=\"ds-form\" role=\"img\" aria-label=\"Form: lost, won, drew, won, won\"><i class=\"ds-l\">L</i><i class=\"ds-w\">W</i><i class=\"ds-d\">D</i><i class=\"ds-w\">W</i><i class=\"ds-w\">W</i></div>",
      "css": ".ds-form{display:inline-flex;gap:1px;background:#EDEDE8;border:1px solid #C9CBC6;border-radius:3px;overflow:hidden}.ds-form i{width:22px;height:22px;display:grid;place-items:center;font-style:normal;font-family:'Jersey 10',monospace;font-variant-numeric:tabular-nums;line-height:1;font-size:18.667px;color:#fff}.ds-w{background:#1E7A46}.ds-d{background:#7D838C;background-image:radial-gradient(circle,rgba(255,255,255,.35) 1px,transparent 1.5px);background-size:12px 12px}.ds-l{background:repeating-linear-gradient(180deg,#EDEDE8 0 4px,#C8102E 4px 6px,#EDEDE8 6px 8px);color:#16181D}"
    },
    {
      "name": "Club Scarf",
      "kind": "custom",
      "refersTo": "club-scarf",
      "description": "A club's own two-tone bar scarf, fringed, name upper-cased on a 2-stitch solid panel.",
      "html": "<div class=\"ds-club\"><b>ATLETI</b></div>",
      "css": ".ds-club{height:72px;display:grid;place-items:center;border:1px solid #C9CBC6;border-radius:3px;background:repeating-linear-gradient(90deg,#CB3524 0 16px,#FFFFFF 16px 32px)}.ds-club b{font-family:'Jersey 10',monospace;font-variant-numeric:tabular-nums;line-height:1;font-weight:400;font-size:37.333px;color:#fff;background:#CB3524;height:100%;display:grid;place-items:center;padding:0 12px}"
    },
    {
      "name": "Share Bar",
      "kind": "custom",
      "refersTo": "share-scarf",
      "description": "A 0-1 probability: share knitted in club colours, remainder a dropped stitch, tabular % at right.",
      "html": "<div class=\"ds-share\"><span class=\"ds-lbl\">Top four</span><div class=\"ds-track\"><div class=\"ds-fill\" style=\"width:96%\"></div></div><span class=\"ds-pct\">96%</span></div>",
      "css": ".ds-share{display:flex;align-items:center;gap:8px;font:400 14px/1.4 Roboto,sans-serif;color:#16181D}.ds-lbl{width:96px}.ds-track{flex:1;height:14px;border:1px solid #C9CBC6;border-radius:3px;overflow:hidden;background:repeating-linear-gradient(180deg,#EDEDE8 0 4px,#C9CBC6 4px 6px,#EDEDE8 6px 8px)}.ds-fill{height:100%;background:repeating-linear-gradient(90deg,#CB3524 0 6px,#FFFFFF 6px 12px)}.ds-pct{width:52px;text-align:right;font-weight:500;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Brand Band and Wordmark",
      "kind": "custom",
      "refersTo": "brand-band",
      "description": "Stitch wordmark in pitch green over Touchline's own 8dp pitch-and-pink scarf band.",
      "html": "<div class=\"ds-brand\"><b>TOUCHLINE</b><div class=\"ds-band8\"></div></div>",
      "css": ".ds-brand{background:#EDEDE8;padding:12px 16px}.ds-brand b{font-family:'Jersey 10',monospace;font-variant-numeric:tabular-nums;line-height:1;font-weight:400;font-size:37.333px;color:#0F3D2E}.ds-band8{margin-top:8px;height:8px;border:1px solid #C9CBC6;border-radius:3px;background:repeating-linear-gradient(90deg,#0F3D2E 0 12px,#F2A7C3 12px 24px)}"
    },
    {
      "name": "Hero Fixture Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat tonal card (no shadow) holding title, kickoff meta, the hero scarf, and a pundit verdict.",
      "html": "<article class=\"ds-card\" tabindex=\"0\"><h3>Bayern v RB Leipzig</h3><p class=\"ds-meta\">Sat 22:00 · Bundesliga</p><p class=\"ds-verdict\">Bayern should handle this. RB Leipzig need a miracle.</p><p class=\"ds-link\">Breakdown ›</p></article>",
      "css": ".ds-card{background:#F6F6F2;border-radius:16px;padding:16px;font-family:Roboto,sans-serif;color:#16181D;transition:background .2s}.ds-card:hover{background:#E6E6E0}.ds-card:focus-visible{outline:2px solid #0F3D2E;outline-offset:2px}.ds-card h3{margin:0;font-size:22px;font-weight:700;letter-spacing:-.2px}.ds-meta{margin:0 0 16px;font-size:14px;color:#4A4F57}.ds-verdict{margin:0 0 4px;font-size:16px;font-weight:600}.ds-link{margin:0;text-align:right;color:#0F3D2E;font-weight:500}"
    },
    {
      "name": "League Chips",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "Filter chips, no checkmark: outline-variant border, pitch fill when selected.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-sel\" aria-pressed=\"true\">All</button><button class=\"ds-chip\" aria-pressed=\"false\">Premier League</button><button class=\"ds-chip\" aria-pressed=\"false\">LaLiga</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font:500 14px Roboto,sans-serif;padding:6px 16px;border-radius:8px;border:1px solid #C9CBC6;background:transparent;color:#4A4F57;cursor:pointer}.ds-chip:hover{background:#E6E6E0}.ds-chip:focus-visible{outline:2px solid #0F3D2E}.ds-sel,.ds-sel:hover{background:#0F3D2E;border-color:#0F3D2E;color:#fff;font-weight:600}"
    },
    {
      "name": "Navigation Bar",
      "kind": "nav",
      "refersTo": "nav-bar",
      "description": "Four destinations on surface-container; paper-pink pill indicator with ink icon when selected. Becomes a rail at 840dp.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-cur\" aria-current=\"page\"><span class=\"ds-pill\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M4 9h16v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z M7 5l2 3 M17 5l-2 3 M12 4v4\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></span>Home</a><a><span class=\"ds-pill\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><path d=\"M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></span>Clubs</a></nav>",
      "css": ".ds-nav{display:flex;background:#E6E6E0;padding:12px 0 16px;font:500 12px Roboto,sans-serif}.ds-nav a{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;color:#4A4F57;cursor:pointer}.ds-pill{width:64px;height:32px;border-radius:16px;display:grid;place-items:center;transition:background .2s}.ds-nav a:hover .ds-pill{background:#DEDED8}.ds-nav a:focus-visible{outline:2px solid #0F3D2E}.ds-nav .ds-cur{color:#16181D}.ds-cur .ds-pill,.ds-nav a.ds-cur:hover .ds-pill{background:#F2A7C3}"
    }
  ],
  "narrative": {
    "northStar": "The Terrace Scarf",
    "overview": "Every prediction is knitted into a supporter's scarf. A fixture is a half-and-half matchday scarf whose seams sit at the win, draw, and loss split; a club's form is a short bar scarf of its last results; a season probability is a scarf with the remainder dropped. The scarf is the chart, so numbers arrive as something a fan already owns rather than as percentage rows on dark cards.\n\nAround the scarves the app is plain Material 3 on cool terrace concrete: flat tonal cards, Roboto for everything that is read, one green and one pink as Touchline's own colours, and every club in its own two-tone pair taken from the data. Stitch-grid lettering (Jersey 10) is reserved for the knit: hero percentages, club names on scarves, the wordmark, scores, and monograms. Density is a two-minute glance: one hero fixture, then short sections with generous air above each heading.",
    "keyCharacteristics": [
      "Probabilities are drawn as knitted scarves whose band widths equal the numbers.",
      "Touchline's scarf is pitch green and paper pink; clubs wear their own colours.",
      "Stitch type only at whole-stitch sizes, Roboto for body and UI.",
      "Results carry shape as well as colour: solid knit, cross-stitch, dropped stitch.",
      "Flat tonal surfaces; only bottom sheets float."
    ],
    "rules": [
      {
        "name": "The Club's Own Colours Rule",
        "body": "Club colours come from the data bundle (`clubs[].colors.primary/secondary`), never from a hand-kept table; a missing pair falls back to the neutral club pair, never to brand green.",
        "section": "colors"
      },
      {
        "name": "The Ink-On-Colour Rule",
        "body": "Text on any colour uses ink when the colour's luminance exceeds 0.36, white otherwise.",
        "section": "colors"
      },
      {
        "name": "The Shape-Before-Colour Rule",
        "body": "Colour is never the only signal: every result and probability band also differs by knit, label, or semantic description.",
        "section": "colors"
      },
      {
        "name": "The Whole-Stitch Rule",
        "body": "Jersey is set only at multiples of one stitch, where 1 stitch = 75/1400 em, so the 18.667px size makes one stitch one logical pixel. Use 18.667, 37.333, or 56; never an in-between size, never letter-spacing.",
        "section": "typography"
      },
      {
        "name": "The Stitch Is For The Knit Rule",
        "body": "Jersey appears on scarves, the wordmark, scores, and monograms. Headings, verdicts, and body copy stay in Roboto.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that sits in a column or updates (percentages, points, money, minutes) uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Only Sheets Float Rule",
        "body": "No shadows on cards, bars, chips, or scarves. If something needs to float, it is a bottom sheet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw any win/draw/loss split or 0-1 share as a scarf whose band widths equal the values.",
      "Do put scarf labels on a solid name panel and separate bands with a 1px ground-colour seam.",
      "Do knit scarves in row by row (650ms, easeOutExpo) and show them complete under reduced motion.",
      "Do set Jersey only at 18.667, 37.333, or 56px.",
      "Do take club colours from the bundle and fall back to the neutral pair.",
      "Do write in a pundit's voice: one plain verdict per item (\"Bayern should handle this.\").",
      "Do present workload as a risk index with a band (\"Heavy · 82\"), and keep trend reasons to 14 characters or fewer.",
      "Do keep 28px above and 8px below every section heading."
    ],
    "donts": [
      "Don't add shadows to cards, chips, or bars; only bottom sheets float.",
      "Don't show workload as an injury probability.",
      "Don't let colour be the only difference between results; keep the knit shapes.",
      "Don't set headings, verdicts, or body text in Jersey.",
      "Don't apply the knit texture outside scarf bands.",
      "Don't fall back to dark navy cards with a green accent and rows of percentages."
    ]
  }
}